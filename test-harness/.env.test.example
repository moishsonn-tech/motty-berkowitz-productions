# Copy to .env.test (gitignored — never commit the real values) and fill in your DEDICATED
# TEST Supabase project's values. NEVER point this at the production project.

# Project Settings → API → Project URL
TEST_SUPABASE_URL=

# Project Settings → API → anon public key (safe-ish, but still test-project-only)
TEST_SUPABASE_ANON_KEY=

# Project Settings → API → service_role key. CROWN JEWEL — bypasses Row Level Security
# entirely. Used ONLY by test-harness/auth.js, server-side, to mint a real session for the
# test user without sending a real email. Never logged, never printed, never used by anything
# that runs in a browser page.
TEST_SUPABASE_SERVICE_ROLE_KEY=

# The email of the one dedicated test user, already inserted into that project's
# allowed_emails table (added_by='test-harness'). Doesn't need to be a real inbox — the
# Admin API session-minting path never actually sends mail.
TEST_USER_EMAIL=test-harness@example.com

# Where the harness serves frontend/ locally (serve.js)
TEST_APP_PORT=8934
